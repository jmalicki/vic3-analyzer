{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Victoria 3 Analyzer",
  "version": "0.5.0",
  "identifier": "com.jmalicki.vic3-analyzer",
  "mainBinaryName": "vic3-analyzer",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build --prefix ../../web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Victoria 3 Analyzer",
        "width": 1200,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
