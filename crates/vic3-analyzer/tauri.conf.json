{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Victoria 3 Analyzer",
  "version": "0.3.0",
  "identifier": "com.jmalicki.vic3-analyzer",
  "mainBinaryName": "vic3-analyzer",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Victoria 3 Analyzer",
        "width": 1200,
        "height": 820,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
