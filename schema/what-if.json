{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Extra building levels applied before a re-solve. Employment stays frozen.",
  "properties": {
    "building_type_id": {
      "description": "Building type index (matches [`crate::WorldBuilding::type_id`]).",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "extra_levels": {
      "description": "Non-negative extra levels added to matching buildings.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "building_type_id",
    "extra_levels"
  ],
  "title": "WhatIfOpts",
  "type": "object"
}
