          "format": "double",
          "type": "number"
        },
        "state_id": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "type_id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type_id",
        "level",
        "staffing",
        "production_method_ids",
        "inputs",
