      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SolveStatus"
    }
  },
  "required": [
    "scope",
    "goods",
    "countries",
    "states",
    "state_goods",
    "buildings",
    "building_types",
    "building_groups",
    "state_pops",
    "inputs",
    "residual",
    "status",
    "limitations"
  ],
  "title": "PricesResult",
  "type": "object"
