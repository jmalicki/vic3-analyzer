        "region_name": {
          "description": "Non-localized region script id when known (e.g. `STATE_RHINE`). Same for\nevery co-owner of a split region. Omitted when the save has no region key.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "region_label",
        "label"
      ],
      "type": "object"
    },
    "StateNeed": {
      "properties": {
        "goods": {
          "items": {
