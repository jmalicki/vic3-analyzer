  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Price-equilibrium output. Every solve / preview / what-if returns this shape.\n\n`limitations` is always at least the crate [`crate::LIMITATIONS`] (preview may\nappend extras). `residual` is always present (I5). `relative` mirrors\n`goods` order for [`SolveOpts::warm_rel`].\n\nBuilt by [`crate::report`] from a [`SolveOutcome`]. Downstream: SQL/MCP\ndiagnostics read the same JSON via `vic3-api` / the SQL session’s last solve.",
  "properties": {
    "building_groups": {
      "items": {
        "$ref": "#/$defs/BuildingGroupInfo"
      },
      "type": "array"
    },
    "building_types": {
      "items": {
        "$ref": "#/$defs/BuildingTypeInfo"
      },
      "type": "array"
    },
    "buildings": {
      "items": {
        "$ref": "#/$defs/BuildingEconomics"
      },
      "type": "array"
    },
    "countries": {
      "items": {
        "$ref": "#/$defs/CountryInfo"
      },
      "type": "array"
    },
    "goods": {
      "items": {
        "$ref": "#/$defs/GoodPrice"
      },
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/MarketInputs",
      "description": "Where the orders behind these prices came from."
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "relative": {
      "description": "Relative prices `price / base` in the same order as [`Self::goods`].\n\nCallers can feed this back as [`SolveOpts::warm_rel`]. Omitted when empty.",
      "items": {
        "format": "double",
        "type": "number"
      },
      "type": "array"
    },
    "residual": {
      "description": "`‖r − r_formula(orders(r))‖₂`. Always present (I5).",
      "format": "double",
      "type": "number"
    },
    "scope": {
      "description": "Prices currently solve one synthetic economy for the whole save.",
      "type": "string"
    },
    "state_goods": {
      "items": {
        "$ref": "#/$defs/StateGood"
      },
      "type": "array"
    },
    "state_needs": {
      "items": {
        "$ref": "#/$defs/StateNeed"
      },
      "type": "array"
    },
    "state_pops": {
      "items": {
        "$ref": "#/$defs/StatePop"
      },
      "type": "array"
    },
    "state_qualifications": {
      "items": {
        "$ref": "#/$defs/StateQualification"
      },
      "type": "array"
    },
    "states": {
      "items": {
        "$ref": "#/$defs/StateInfo"
      },
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/SolveStatus"
    }
  },
  "required": [
    "scope",
    "goods",
    "countries",
    "states",
    "state_goods",
    "buildings",
    "building_types",
    "building_groups",
    "state_pops",
    "inputs",
    "residual",
    "status",
    "limitations"
  ],
  "title": "PricesResult",
  "type": "object"
}
