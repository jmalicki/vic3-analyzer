          "type": [
            "string",
            "null"
          ]
        },
        "flag_data_url": {
          "description": "PNG data URL for the selected flag, when the defs blob rendered it.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Paradox country id from the save.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "description": "Localized country name (e.g. `Prussia` for tag `PRU`).",
          "type": "string"
        },
