          "type": "string"
        },
        "market_id": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "region_label": {
          "description": "Bare geographic display name from defs (same for all co-owners of a split region).",
