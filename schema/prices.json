        "name",
        "quantity",
        "value"
      ],
      "type": "object"
    },
    "GoodPrice": {
      "description": "One row of the goods table in [`PricesResult`].",
      "properties": {
        "base": {
          "format": "double",
          "type": "number"
        },
        "buy": {
          "format": "double",
          "type": "number"
        },
        "label": {
          "description": "Localized or humanized display name for UI / SQL `label` filters.",
          "type": "string"
        },
        "name": {
          "description": "Good script id (`GameDefs::goods_order` key), e.g. `grain`.",
          "type": "string"
        },
        "price": {
          "format": "double",
          "type": "number"
        },
        "sell": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "label",
        "base",
        "price",
        "buy",
        "sell"
      ],
      "type": "object"
    },
    "MarketInputs": {
      "description": "What the save and definitions actually contributed to the market.\n\nEvery price equals its base price when nothing places an order, and that\nsolve reports `converged` with a zero residual. These counts tell the two\ncases apart: a genuinely balanced market versus a market with no orders in\nit because the save or the definitions did not supply any.",
      "properties": {
        "buildings": {
          "description": "Buildings whose goods flows entered the solve.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "buildings_without_method": {
          "description": "Buildings with neither saved IO nor a production method present in the\ndefinitions.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "buildings_without_orders": {
          "description": "Buildings with no non-zero saved IO and no usable PM fallback orders.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "goods_with_orders": {
          "description": "Goods carrying a non-zero buy or sell order. Zero means every price\nbelow is just its base price.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "pops": {
          "description": "Pops whose consumption entered the solve.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped_buildings": {
          "description": "Save buildings dropped for a missing type id.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "skipped_pops": {
          "description": "Save pops dropped for missing `workforce`/`dependents` (or legacy\npopulation fields) or `wealth`.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pops",
        "skipped_pops",
        "buildings",
        "skipped_buildings",
        "buildings_without_method",
        "buildings_without_orders",
        "goods_with_orders"
      ],
      "type": "object"
    },
    "PopNeedBasket": {
      "properties": {
        "goods": {
          "items": {
            "$ref": "#/$defs/GoodFlow"
          },
          "type": "array"
        },
        "label": {
          "description": "Localized need name for display.",
          "type": "string"
        },
        "name": {
          "description": "Need package script id (e.g. `popneed_basic_food`).",
          "type": "string"
        },
        "package_value": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "name",
        "label",
        "package_value",
        "goods"
      ],
      "type": "object"
    },
    "ProfessionCount": {
      "properties": {
        "count": {
          "format": "double",
          "type": "number"
        },
        "label": {
          "description": "Localized profession name for display.",
          "type": "string"
        },
        "name": {
          "description": "Profession / pop-type script id.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "count"
      ],
      "type": "object"
    },
    "SolveStatus": {
      "description": "Why [`crate::solve`] stopped.",
      "oneOf": [
        {
          "const": "converged",
          "description": "[`PricesResult::residual`] is below [`SolveOpts::residual_eps`] (I5).",
          "type": "string"
        },
        {
          "const": "max_iters",
          "description": "Iteration budget exhausted with residual still at or above ε.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Basin reported failure and successive substitution did not recover.",
          "type": "string"
        }
      ]
    },
    "StateGood": {
      "properties": {
        "base": {
          "format": "double",
          "type": "number"
        },
        "buy": {
          "format": "double",
          "type": "number"
        },
        "effective_mapi": {
          "description": "Base MAPI 0.75 multiplied by [`Self::market_access`].",
          "format": "double",
          "type": "number"
        },
        "market_access": {
          "description": "Infrastructure-only state market access in `[0, 1]`.",
          "format": "double",
          "type": "number"
        },
        "market_price": {
          "description": "Solved whole-save market price (Milestone 1; per-market solves follow).",
          "format": "double",
          "type": "number"
        },
        "name": {
          "description": "Good script id (join key to [`GoodPrice::name`] / `goods.name`).",
          "type": "string"
        },
        "price": {
          "description": "Final local price after blending market and pure state prices\n(`local_price(effective_mapi, market_price, state_price)`).",
          "format": "double",
          "type": "number"
        },
        "sell": {
          "format": "double",
          "type": "number"
        },
        "state_id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "state_price": {
          "description": "Pure-state price used as the MAPI blend input (box-constrained; game band).\n\nJoint: free NLS unknown. Nested: reconstructed from the settled local so\nthe MAPI identity holds on the emitted row.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "state_id",
        "name",
        "buy",
        "sell",
        "price",
        "market_price",
        "state_price",
        "market_access",
        "effective_mapi",
        "base"
      ],
      "type": "object"
    },
