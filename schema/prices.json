  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Price-equilibrium output. `limitations` is always the crate [`crate::LIMITATIONS`].",
  "properties": {
    "building_groups": {
      "items": {
        "$ref": "#/$defs/BuildingGroupInfo"
      },
      "type": "array"
    },
    "building_types": {
      "items": {
        "$ref": "#/$defs/BuildingTypeInfo"
      },
      "type": "array"
    },
    "buildings": {
      "items": {
        "$ref": "#/$defs/BuildingEconomics"
      },
      "type": "array"
    },
    "countries": {
      "items": {
        "$ref": "#/$defs/CountryInfo"
      },
      "type": "array"
    },
    "goods": {
      "items": {
        "$ref": "#/$defs/GoodPrice"
      },
      "type": "array"
    },
    "inputs": {
      "$ref": "#/$defs/MarketInputs",
      "description": "Where the orders behind these prices came from."
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "residual": {
      "description": "`‖r − r_formula(orders(r))‖₂`. Always present (I5).",
      "format": "double",
      "type": "number"
    },
    "scope": {
      "description": "Prices currently solve one synthetic economy for the whole save.",
      "type": "string"
    },
    "state_goods": {
