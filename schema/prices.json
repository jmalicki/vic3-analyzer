            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "CountryInfo": {
      "properties": {
        "flag_coa": {
          "description": "Selected coat-of-arms id when a current flag could be determined.",
          "type": [
            "string",
            "null"
          ]
        },
        "flag_data_url": {
          "description": "PNG data URL for the selected flag, when the defs blob rendered it.",
          "type": [
            "string",
            "null"
          ]
        },
