          "type": "number"
        },
        "jobs": {
          "format": "double",
          "type": "number"
        },
        "label": {
          "description": "Localized profession name for display.",
          "type": "string"
        },
        "monthly_change": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "description": "Target profession script id for this qualification row.",
          "type": "string"
        },
        "qualified": {
          "format": "double",
          "type": "number"
        },
        "shortage": {
          "format": "double",
          "type": "number"
        },
        "state_id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "state_id",
        "name",
        "label",
        "qualified",
        "employed",
        "jobs",
        "shortage"
      ],
      "type": "object"
