{
  "$defs": {
    "BuildingEconomics": {
      "properties": {
        "building_type_id": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "building_type_label": {
          "description": "Localized building type name for display (parallel to [`Self::building_type_name`]).",
          "type": "string"
        },
        "building_type_name": {
          "description": "Building type script id for this instance.",
          "type": "string"
        },
        "cost": {
          "format": "double",
          "type": "number"
        },
        "employees": {
          "items": {
            "$ref": "#/$defs/ProfessionCount"
          },
          "type": "array"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/GoodFlow"
          },
          "type": "array"
        },
        "level": {
          "format": "double",
          "type": "number"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/GoodFlow"
          },
          "type": "array"
        },
        "production_method_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profit": {
          "format": "double",
          "type": "number"
        },
        "revenue": {
          "format": "double",
          "type": "number"
        },
        "short_inputs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "staffing": {
          "format": "double",
          "type": "number"
        },
        "state_id": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "building_type_name",
        "building_type_label",
        "level",
        "staffing",
        "production_method_ids",
        "inputs",
        "outputs",
        "revenue",
        "cost",
        "profit",
        "short_inputs"
      ],
      "type": "object"
    },
    "BuildingGroupInfo": {
      "properties": {
