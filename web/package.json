{
  "name": "web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:wasm && pnpm run build:defs && tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "build:wasm": "wasm-pack build ../crates/vic3-wasm --target web --out-dir ../../web/public/wasm --out-name vic3_wasm && rm -f public/wasm/.gitignore public/wasm/package.json",
    "build:defs": "cargo run -q -p vic3-defs --bin emit_fixture_blob -- fixtures/defs.postcard",
    "bench:defs": "node scripts/defs-bench.mjs",
    "bench:prices": "node scripts/prices-bench.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:wasm": "pnpm run build:wasm && pnpm run build:defs && vitest run --project wasm",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@wdio/tauri-plugin": "^1.3.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.80.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
