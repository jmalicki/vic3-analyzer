{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wasm && npm run build:defs && tsc -b && vite build",
    "build:wasm": "wasm-pack build ../crates/vic3-wasm --target web --out-dir ../../web/public/wasm --out-name vic3_wasm && rm -f public/wasm/.gitignore public/wasm/package.json",
    "build:defs": "cargo run -q -p vic3-defs --bin emit_fixture_blob -- public/defs.postcard",
    "lint": "oxlint",
    "test": "vitest run --project unit",
    "test:wasm": "npm run build:wasm && npm run build:defs && vitest run --project wasm",
    "preview": "vite preview"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
