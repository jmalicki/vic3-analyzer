{
  "name": "vic3-docs-screenshots",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright harness for player-facing docs screenshots (web + desktop mock).",
  "scripts": {
    "docs:screenshots": "node run-all.mjs",
    "docs:screenshots:web": "node capture-web.mjs",
    "docs:screenshots:desktop:mock": "node capture-desktop-mock.mjs",
    "docs:screenshots:compare": "node compare.mjs",
    "docs:screenshots:desktop:tauri": "node desktop-tauri/run.mjs"
  },
  "devDependencies": {
    "pixelmatch": "^7.1.0",
    "playwright": "^1.54.2",
    "pngjs": "^7.0.0",
    "serve-handler": "^6.1.6"
  }
}
